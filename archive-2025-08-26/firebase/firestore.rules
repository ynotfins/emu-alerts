rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /alerts/{docId} {
      allow read: if request.auth != null && (
        (request.auth.token.role == "employee" && (resource.data.audience in ["employee", "both"])) ||
        (request.auth.token.role == "customer" && (resource.data.audience in ["customer", "both"]))
      );
      allow write: if request.auth != null && request.auth.token.role == "employee";
    }
  }
}
