<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EmuAlerts" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Emergency theme colors -->
        <item name="colorPrimary">@color/red_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/red_500</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorError">@color/red_900</item>
        <item name="colorOnError">@color/white</item>
        <!-- System bars -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
    </style>
</resources>
