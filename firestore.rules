rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Public app reads (auth required) ---
    // Alerts list + details
    match /alerts/{alertId} {
      allow read: if request.auth != null;
      allow write: if false; // keep write-protected
    }
    // Optional: updates subcollection if you use it
    match /alerts/{alertId}/updates/{updateId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // --- Per-user data (locations, assignments, etc.) ---
    match /users/{uid}/locations/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // --- Messaging (only participants) ---
    // Example shape: threads/{threadId} has {participants: {uid: true, ...}}
    match /threads/{threadId} {
      allow read: if request.auth != null &&
                  (request.auth.uid in resource.data.participants);
      allow write: if false; // tighten later with server functions
    }
    match /threads/{threadId}/messages/{msgId} {
      allow read: if request.auth != null &&
                  (request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participants);
      allow write: if false;
    }

    // Deny everything else by default
    match /{document=**} { allow read, write: if false; }
  }
}