// Firestore security rules for employee-facing app
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isEmployee() {
      return request.auth != null && (request.auth.token.role == 'employee' || request.auth.token.role == 'manager');
    }

    // Incidents snapshot (home list)
    match /incidents/{id} {
      allow read: if isEmployee();
      allow write: if false; // writes only via Cloud Functions
      // History (detail screen)
      match /updates/{doc} {
        allow read: if isEmployee();
        allow write: if false;
      }
    }

    // Flat alerts feed (optional)
    match /alerts/{doc} {
      allow read: if isEmployee();
      allow write: if false;
    }

    // Live employee location (future feature)
    match /userStatus/{uid} {
      // Only managers see all; relax to isEmployee() if needed
      allow read: if request.auth != null && request.auth.token.role == 'manager';
      // Users can update only their own document
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
